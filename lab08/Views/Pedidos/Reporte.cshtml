@model IEnumerable<PedidoReporte>

@{
    ViewData["Title"] = "Reporte de pedidos";
}

<h1>Reporte de pedidos</h1>
<p class="text-muted">Detalle de pedidos por intervalo de fechas.</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="Reporte" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-sm-4 col-md-3">
        <label for="desde" class="form-label">Desde</label>
        <input id="desde" name="desde" type="date" value="@ViewData["Desde"]" class="form-control" />
    </div>
    <div class="col-sm-4 col-md-3">
        <label for="hasta" class="form-label">Hasta</label>
        <input id="hasta" name="hasta" type="date" value="@ViewData["Hasta"]" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Consultar</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Pedido</th>
                <th>Fecha</th>
                <th>Cliente</th>
                <th>Producto</th>
                <th class="text-end">Cantidad</th>
                <th class="text-end">Subtotal</th>
                <th>Fecha requerida</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fila in Model)
            {
                <tr>
                    <td>@fila.PedidoID</td>
                    <td>@fila.FechaPedido.ToString("dd/MM/yyyy")</td>
                    <td>@fila.Cliente</td>
                    <td>@fila.Producto</td>
                    <td class="text-end">@fila.Cantidad</td>
                    <td class="text-end">@fila.Subtotal.ToString("C2")</td>
                    <td>@fila.FechaRequerida?.ToString("dd/MM/yyyy")</td>
                    <td>@fila.Estado</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay pedidos en el intervalo seleccionado.</div>
}
